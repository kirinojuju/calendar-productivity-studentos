# Generate a unique password and copy this file to .env before starting Docker.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://studentos:replace-with-a-long-random-password@127.0.0.1:5433/studentos
API_PORT=3001
API_HOST=127.0.0.1
# Set this to the public site origin when serving through a reverse proxy.
APP_ORIGIN=http://127.0.0.1:5173

# Firebase web app configuration (copy values into .env.local; never commit that file)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
